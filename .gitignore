__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
/dist
.venv/
venv/
# Pip / setuptools build artefacts (both project root and nested)
/build/
/build-*/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Node
frontend/node_modules/
frontend/dist/
# The vite build target — regenerated by `npm run build`.
backend/_static/
# TypeScript incremental build cache
frontend/tsconfig.tsbuildinfo

# Pyodide bundle — rebuilt by pyodide_poc/build_bundle.sh
pyodide_poc/bundle.zip
frontend/public/bundle.zip

# Runtime / user data
~/.pyspider/
/tmp/pyspider-backend.log
*.mrcs.tmp

# Huge datasets — not for git. Users pull the RELION tutorial themselves.
relion30_tutorial_data.tar
relion40_tutorial_precalculated_results.tar.gz
tutorial_data/

# Local runtime / scratch state
.claude/
pyspider_web.egg-info/

# Local user tutorials (Tutorial Maker writes here at runtime)
!backend/tutorials/*.json
